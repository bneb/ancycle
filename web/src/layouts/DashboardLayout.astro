---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Ancycle Dashboard" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | Ancycle</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-[#0A0A0A] text-gray-100 font-sans antialiased selection:bg-blue-500/30">
        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar -->
            <aside class="w-64 border-r border-white/10 bg-black/50 backdrop-blur-xl flex flex-col transition-all">
                <div class="h-16 flex items-center px-6 border-b border-white/10">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded bg-gradient-to-tr from-blue-600 to-cyan-400"></div>
                        <span class="font-outfit font-bold text-lg tracking-tight">Ancycle</span>
                    </div>
                </div>
                
                <nav class="flex-1 p-4 space-y-1">
                    <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-white/5 text-white font-medium hover:bg-white/10 transition-colors">
                        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        Overview
                    </a>
                    <a href="/dashboard/runs" class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
                        <svg class="w-5 h-5 text-gray-400 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        PR Runs
                    </a>
                    <a href="/billing" class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 font-medium transition-colors">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                        Billing
                    </a>
                </nav>
                
                <div class="p-4 border-t border-white/10">
                    <div class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white cursor-pointer transition-colors">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-r from-purple-500 to-blue-500"></div>
                        <div class="flex flex-col">
                            <span class="font-medium text-white">kevin</span>
                            <span class="text-xs">Free Plan</span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto relative">
                <!-- Background decoration -->
                <div class="absolute top-0 left-0 w-full h-96 bg-gradient-to-b from-blue-900/20 to-transparent pointer-events-none -z-10"></div>
                
                <header class="h-16 flex items-center justify-between px-8 border-b border-white/5 bg-black/20 backdrop-blur-md sticky top-0 z-10">
                    <h1 class="text-xl font-semibold font-outfit text-white">{title}</h1>
                    <div class="flex items-center gap-4">
                        <button class="text-sm px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-md font-medium transition-colors shadow-[0_0_15px_rgba(37,99,235,0.3)] hover:shadow-[0_0_20px_rgba(37,99,235,0.5)]">
                            Connect GitHub
                        </button>
                    </div>
                </header>
                
                <div class="p-8 max-w-7xl mx-auto z-0">
                    <slot />
                </div>
            </main>
        </div>
    </body>
</html>

<style is:global>
    @import "tailwindcss";
    
    :root {
        --font-sans: 'Inter', sans-serif;
        --font-outfit: 'Outfit', sans-serif;
    }
</style>
