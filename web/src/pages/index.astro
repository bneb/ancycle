---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Ancycle | Formal Verification for dbt</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    </head>
    <body class="bg-[#050505] text-white font-sans selection:bg-blue-500/30">
        <!-- Grid Background -->
        <div class="fixed inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
        <div class="fixed inset-0 bg-gradient-to-t from-[#050505] to-transparent pointer-events-none"></div>

        <main class="relative min-h-screen flex flex-col items-center justify-center p-6 text-center">
            <!-- Glow effect -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-blue-500/20 blur-[100px] rounded-full pointer-events-none"></div>
            
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-sm text-blue-300 font-medium mb-8 backdrop-blur-md">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                </span>
                Ancycle Cloud v2.0 is now live
            </div>

            <h1 class="font-outfit text-5xl md:text-7xl font-bold tracking-tight mb-6 max-w-4xl">
                Prevent Data Incidents with <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Formal Verification</span>
            </h1>
            
            <p class="text-gray-400 text-lg md:text-xl max-w-2xl mb-10 leading-relaxed">
                Ancycle translates your dbt models into SMT constraints and proves the absence of logical contradictions before you merge. Catch data anomalies at compile-time.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
                <a href="/dashboard" class="px-8 py-3 rounded-xl bg-white text-black font-semibold hover:bg-gray-200 transition-colors flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                    Sign in with GitHub
                </a>
                <a href="https://github.com/kevin/ancycle" target="_blank" class="px-8 py-3 rounded-xl bg-white/5 text-white border border-white/10 font-medium hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
                    View Documentation
                </a>
            </div>

            <!-- Dashboard Preview -->
            <div class="mt-20 relative w-full max-w-5xl mx-auto">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-2xl blur opacity-20"></div>
                <div class="relative bg-black/80 rounded-2xl border border-white/10 shadow-2xl p-2 backdrop-blur-sm">
                    <div class="h-8 flex items-center px-4 border-b border-white/10 mb-4 gap-2">
                        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                    </div>
                    <div class="bg-[#0A0A0A] rounded-lg border border-white/5 p-8 text-left font-mono text-sm text-gray-300">
                        <div class="text-blue-400 mb-2">$ ancycle check --manifest target/manifest.json</div>
                        <div>[Ancycle] Parsing DAG and analyzing SQL nodes...</div>
                        <div>[Ancycle] Found 3 models and 2 dependencies.</div>
                        <div class="text-green-400 mt-2">✅ OK: stg_users -> safe_model</div>
                        <div class="text-red-400">❌ FATAL: CONTRADICTION DETECTED between stg_users -> process_churn</div>
                    </div>
                </div>
            </div>
        </main>
        
        <style is:global>
            @import "tailwindcss";
            
            :root {
                --font-sans: 'Inter', sans-serif;
                --font-outfit: 'Outfit', sans-serif;
            }
        </style>
    </body>
</html>
