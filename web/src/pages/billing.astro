---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Billing & Subscription">
    <div class="max-w-4xl mx-auto">
        <!-- Current Plan -->
        <div class="bg-gradient-to-r from-blue-900/40 to-purple-900/40 border border-blue-500/30 rounded-2xl p-8 mb-8 relative overflow-hidden backdrop-blur-md shadow-[0_0_40px_rgba(37,99,235,0.15)]">
            <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-blue-500/20 blur-3xl rounded-full pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h2 class="text-2xl font-bold text-white mb-2 font-outfit">Free Tier</h2>
                    <p class="text-blue-200">You are currently on the community plan. Enjoy basic dbt model verification with up to 50 edges.</p>
                </div>
                <div class="shrink-0">
                    <div class="text-3xl font-bold text-white mb-1">$0 <span class="text-lg text-blue-300 font-normal">/ month</span></div>
                </div>
            </div>
        </div>

        <!-- Pricing Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Startup Plan -->
            <div class="bg-black/40 border border-white/10 rounded-2xl p-8 flex flex-col hover:border-white/20 transition-colors">
                <h3 class="text-xl font-bold text-white mb-2">Startup</h3>
                <p class="text-gray-400 text-sm mb-6 h-10">Perfect for small data teams looking to prevent regressions.</p>
                
                <div class="text-4xl font-bold text-white mb-6 font-outfit">$49 <span class="text-lg text-gray-500 font-normal">/ mo</span></div>
                
                <ul class="space-y-4 mb-8 flex-1">
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Up to 500 dbt models verified
                    </li>
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Unlimited PR runs
                    </li>
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Standard email support
                    </li>
                </ul>
                
                <button class="w-full py-3 rounded-xl bg-white text-black font-semibold hover:bg-gray-200 transition-colors">Upgrade to Startup</button>
            </div>

            <!-- Enterprise Plan -->
            <div class="bg-gradient-to-b from-gray-800/80 to-black/60 border border-gray-700 rounded-2xl p-8 flex flex-col relative overflow-hidden">
                <div class="absolute top-0 right-0 px-4 py-1 bg-gradient-to-r from-orange-400 to-amber-500 text-black text-xs font-bold uppercase tracking-wider rounded-bl-lg">Recommended</div>
                
                <h3 class="text-xl font-bold text-white mb-2">Enterprise</h3>
                <p class="text-gray-400 text-sm mb-6 h-10">Advanced SMT bounds and infinite scalability for massive DAGs.</p>
                
                <div class="text-4xl font-bold text-white mb-6 font-outfit">$299 <span class="text-lg text-gray-500 font-normal">/ mo</span></div>
                
                <ul class="space-y-4 mb-8 flex-1">
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Unlimited dbt models
                    </li>
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Dedicated Edge Z3 Workers
                    </li>
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        SSO & Custom SAML
                    </li>
                    <li class="flex items-center gap-3 text-sm text-gray-300">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        24/7 Priority Support
                    </li>
                </ul>
                
                <button class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold hover:from-blue-500 hover:to-indigo-500 transition-all shadow-lg shadow-blue-500/25">Contact Sales</button>
            </div>
        </div>
    </div>
</DashboardLayout>
